+def _linear_feed_from_cfeed(cfeed_deg_min: float, radius_mm: float) -> float:
+    return max(0.0, _safe_float(cfeed_deg_min, 0.0) * math.pi * max(_safe_float(radius_mm, 0.0), 1e-9) / 180.0)
